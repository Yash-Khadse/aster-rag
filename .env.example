# Copy to .env; never commit credentials.
ENVIRONMENT=local
APP_ENV=local
DATABASE_URL=sqlite:///data/app.db
DATA_DIR=data
# Local mode generates and persists a random signing secret when empty.
JWT_SECRET=
# Explicit origins only ('*' is rejected: sessions use credentialed cookies).
CORS_ORIGINS=http://localhost:3000
# Email verification: defaults to true when ENVIRONMENT=hosted, false otherwise. Hosted requires SMTP_HOST.
REQUIRE_EMAIL_VERIFICATION=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
# Base URL of the web app; verification links are WEB_URL/?verify=<token>.
WEB_URL=http://localhost:3000
# Open self-registration: anyone can create an organization (no email verification). Set false for invite-only.
REGISTRATION_ENABLED=true
# Trust the last X-Forwarded-For hop as client IP; only behind exactly one reverse proxy.
TRUST_PROXY=false
DEMO_ENABLED=false
DEMO_WORKSPACE_ID=
DEMO_ACCOUNTS_PER_HOUR=100
MAX_UPLOAD_BYTES=5242880
MAX_WORKSPACE_DOCUMENTS=500
MAX_WORKSPACE_BYTES=524288000
MAX_RETRIEVAL_CHUNKS=50000
SSE_HEARTBEAT_SECONDS=15
MONTHLY_QUERY_LIMIT=1000
REQUESTS_PER_MINUTE=30
STORAGE_BACKEND=local
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=documents
EMBEDDING_PROVIDER=fastembed
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
VECTOR_BACKEND=qdrant
QDRANT_PATH=data/qdrant
PINECONE_API_KEY=
PINECONE_INDEX=
RERANKER_PROVIDER=fastembed
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
MODEL_CACHE_DIR=data/models
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
OLLAMA_BASE_URL=http://localhost:11434/v1
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
ALLOW_PAID_PROVIDERS=false
# Optional JSON registry: version, models keyed provider/model with
# input_per_million_usd and output_per_million_usd. Unknown rates remain null.
PRICING_REGISTRY_PATH=
RERANKER_TIMEOUT_SECONDS=15
CONTEXT_TOKEN_BUDGET=1800
RETRIEVAL_CANDIDATES=20
# Optional CPU OCR needs Poppler pdftoppm and Tesseract installed on the API/worker host.
OCR_ENABLED=false
PDFTOPPM_PATH=pdftoppm
TESSERACT_PATH=tesseract
OCR_LANGUAGE=eng
